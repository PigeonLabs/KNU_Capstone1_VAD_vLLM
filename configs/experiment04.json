{
  "experiment": "04",
  "scope": "R01_phase_conditioned_normal_progress",
  "scene": "R01",
  "seed": 42,
  "stride_frames": 4,
  "detector": "IDEA-Research/grounding-dino-tiny",
  "detector_threshold": 0.25,
  "text_threshold": 0.25,
  "encoder": "openai/clip-vit-base-patch32",
  "encoder_frozen": true,
  "tracker": "class_gated_hungarian_iou",
  "tracker_iou_threshold": 0.2,
  "tracker_max_age_samples": 2,
  "phase_smoothing_samples": 3,
  "pca_variance": 0.95,
  "pca_max_rank": 32,
  "minimum_phase_samples": 10,
  "transition_laplace_alpha": 1.0,
  "visual_process_weight": 0.5,
  "calibration_quantile": 0.99,
  "label_policy": "strict_length_matched_only",
  "score_densification": "causal_zero_order_hold",
  "time_unit": "source_frame_index",
  "local_vlm_url": "http://127.0.0.1:8080",
  "local_vlm": {
    "model": "Qwen3.8-27B-Q8_0.gguf",
    "context_per_request": 65536,
    "temperature": 0.2,
    "gpu_layers": "all",
    "reasoning": "on",
    "parallel": 1,
    "other_server_options": "defaults"
  },
  "spatial_phase": {
    "role": 0,
    "k": 3,
    "min_track_samples": 3,
    "min_displacement": 0.1,
    "band_padding": 0.03,
    "smoothing": 3,
    "seed": 42
  },
  "product_roi": {
    "role": 0,
    "min_track_samples": 3,
    "min_displacement": 0.1,
    "padding": 0.03
  },
  "normal_progress": {
    "minimum_samples": 10,
    "scale_floor": 1e-06
  },
  "process_augmentation": "max(transition_percentile,motion_percentile) if valid progress else transition_percentile"
}
